import { CONFIG } from '../config.js';
import { dominantBody } from '../entities/bodies.js';

export function updateImpulse(state, input, system, dtRealSeconds) {
  const ship = state.ship;
  const planet = dominantBody(system, ship.x, ship.y);
  const inHill = planet !== null;

  if (inHill) {
    const distToPlanet = Math.hypot(ship.x - planet.x, ship.y - planet.y);
    const miniR = planet.hill * CONFIG.autopilot.miniHillFraction;

    if (distToPlanet < miniR) {
      ship.impulse += (CONFIG.impulse.maxCharge / 5.0) * dtRealSeconds;
      if (ship.impulse >= CONFIG.impulse.maxCharge) {
        ship.impulse = CONFIG.impulse.maxCharge;
      }
    }
  }

  const wasSpace = ship._wasSpace || false;
  ship._wasSpace = input.space;

  if (inHill) {
    ship.timeWarpActive = false;
    return;
  }

  if (input.space && !wasSpace) {
    if (ship.impulse >= CONFIG.impulse.maxCharge - 0.01) {
      ship.impulse = 0;
      
      const nx = Math.cos(ship.angle) * 50;
      const ny = Math.sin(ship.angle) * 50;
      if (Number.isFinite(nx)) ship.vx = nx;
      if (Number.isFinite(ny)) ship.vy = ny;
    }
  }
}
