import { CONFIG } from '../config.js';

// Колесо мыши → изменение зума. Экспортирует объект camera,
// который читает рендер.
export const camera = { zoom: 1 };

export function bindWheel(canvasEl) {
  const { zoomMin, zoomMax, zoomStep } = CONFIG.camera;

  canvasEl.addEventListener('wheel', (e) => {
    e.preventDefault();

    // deltaY < 0 — колесо от себя (приближение), > 0 — на себя (отдаление).
    // Нормализуем по знаку, а не по величине — шаг всегда одинаковый.
    const factor = e.deltaY < 0 ? zoomStep : 1 / zoomStep;
    camera.zoom = Math.min(zoomMax, Math.max(zoomMin, camera.zoom * factor));
  }, { passive: false });
}
