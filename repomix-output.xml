<file path="public/js/main.js">
import { CONFIG } from './config.js';
import { state } from './core/state.js';
import { simulateTick, predictTrajectory, predictStopPoint, predictSideTrajectories } from './core/physics.js';
import { advanceWorld, updateWorldGeneration, updateShipSystem } from './world/world.js';
import { startLoop } from './core/loop.js';
import { input, bindControls } from './input/controls.js';
import { camera, bindWheel } from './input/wheel.js';
import { createCanvas } from './render/canvas.js';
import { createStarField } from './render/stars.js';
import { drawShip } from './render/ship.js';
import { drawBodies } from './render/bodies.js';
import { drawPrediction } from './render/prediction.js';
import { drawTrail } from './render/trail.js';
import { drawOrbitHints } from './render/orbitHints.js';
import { drawDistantSystems } from './render/worldOverlay.js';
import { drawImpulseBar } from './render/impulseBar.js';
import { drawThrottleIndicator } from './render/throttleIndicator.js';
import { createHud } from './render/hud.js';
import { dominantBody } from './entities/bodies.js';
import {
  beginFrame, endFrame, addTick,
  tStart, tEnd, drawProfiler,
} from './core/profiler.js';

const canvasEl = document.getElementById('space');
const canvas = createCanvas(canvasEl);
const stars = createStarField();
const hud = createHud();

camera.zoom = CONFIG.camera.startZoom;

const camState = {
  x: state.ship.x,
  y: state.ship.y,
  angle: state.ship.angle,
  zoom: camera.zoom,
};

let lastSystemRef = null;
let lastHillPlanet = null;
let zoomBeforeHill = camera.zoom;
let lastFrameTime = performance.now();

function resize() {
  const vp = canvas.resize();
  state.viewport = vp;
  stars.init(vp.width, vp.height);
}
window.addEventListener('resize', resize);
resize();

bindControls({
  btnThrust:  document.getElementById('thrust'),
  btnReverse: document.getElementById('reverse'),
  btnLeft:    document.getElementById('left'),
  btnRight:   document.getElementById('right'),
});
bindWheel(canvasEl);

function onTick(dtReal) {
  tStart('gen');
  updateWorldGeneration(state.world, state.ship.x, state.ship.y);
  addTick('gen', tEnd('gen'));

  tStart('shipSys');
  updateShipSystem(state.world, state.ship.x, state.ship.y);
  addTick('shipSys', tEnd('shipSys'));

  tStart('phys');
  const safeDt = Math.min(0.1, Math.max(0, dtReal));
  simulateTick(state, input, state.bodies, safeDt);
  addTick('phys', tEnd('phys'));

  tStart('advance');
  advanceWorld(state.world);
  addTick('advance', tEnd('advance'));

  tStart('trail');
  advanceTrail();
  addTick('trail', tEnd('trail'));
}

function advanceTrail() {
  const t = state.trail;
  if (state.tickCount % t.sampleEvery !== 0) return;
  t.points.push({ x: state.ship.x, y: state.ship.y });
  if (t.points.length > t.maxPoints) t.points.shift();
}

function angleDiff(a, b) {
  let d = b - a;
  while (d >  Math.PI) d -= Math.PI * 2;
  while (d < -Math.PI) d += Math.PI * 2;
  return d;
}

function getOuterOrbit(system) {
  let outer = 0;
  for (const p of system.planets) {
    if (p.orbit > outer) outer = p.orbit;
  }
  return outer || 1000;
}

function getNearestSystem(world, x, y) {
  let best = null;
  let bestDist = Infinity;
  for (const sys of world.systems.values()) {
    if (!sys) continue;
    const d = Math.hypot(x - sys.cx, y - sys.cy);
    if (d < bestDist) {
      best = sys;
      bestDist = d;
    }
  }
  return best;
}

function computeCameraTarget(vp) {
  const ship = state.ship;
  const system = state.world.shipSystem;
  const planet = dominantBody(system, ship.x, ship.y);

  if (system !== lastSystemRef) {
    if (!lastSystemRef && system) {
      const outer = getOuterOrbit(system);
      camera.zoom = (Math.min(vp.width, vp.height) * CONFIG.hill.fitFraction) / (2 * outer);
    } else if (lastSystemRef && !system) {
      camera.zoom = CONFIG.camera.zoomMin;
    } else if (lastSystemRef && system && lastSystemRef !== system) {
      const outer = getOuterOrbit(system);
      camera.zoom = (Math.min(vp.width, vp.height) * CONFIG.hill.fitFraction) / (2 * outer);
    }
    lastSystemRef = system;
    lastHillPlanet = null;
  }

  if (planet !== lastHillPlanet) {
    if (planet && !lastHillPlanet) {
      zoomBeforeHill = camera.zoom;
      camera.zoom = (Math.min(vp.width, vp.height) * CONFIG.hill.fitFraction) / (2 * planet.hill);
    } else if (!planet && lastHillPlanet) {
      camera.zoom = zoomBeforeHill;
    }
    lastHillPlanet = planet;
  }

  let targetX = ship.x;
  let targetY = ship.y;

  // Если мы ВНЕ системы, смещаем камеру.
  // Нам нужно, чтобы корабль был в центре нижней четверти экрана.
  // Это значит, что по экранной оси Y он должен быть на 25% высоты экрана ниже центра.
  // В пикселях это vp.height * 0.25.
  // Камера должна смотреть на 25% ВЫШЕ корабля в экранных координатах.
  if (!system) {
    const offsetScreenY = vp.height * 0.25; // смещение в пикселях
    const offsetWorld = offsetScreenY / camState.zoom;
    
    // Вектор "вверх" на экране (0, -1) в мировых координатах с учётом поворота камеры.
    // Камера отрисовывает мир, поворачивая его на (-Math.PI / 2 - camState.angle).
    // Значит, чтобы сдвинуть камеру вверх по экрану, мы смещаем её вдоль мирового вектора,
    // который после поворота станет (0, -1).
    // Это вектор (Math.cos(camState.angle + Math.PI), Math.sin(camState.angle + Math.PI))
    // Или проще: (cos(angle), sin(angle)) для направления вперед. 
    // Нам нужно вверх. Вектор "вверх" для корабля (носа) — это (cos(angle), sin(angle)).
    // Если смотреть вдоль носа, ось Y экрана — это перпендикуляр.
    // Сместим камеру по локальной оси носа.
    
    // Если корабль смотрит вверх (angle = -Math.PI/2), вектор "вперед" = (0, -1). 
    // На экране корабль в центре. Если мы сдвигаем камеру вдоль "вперед" (на -Y), 
    // корабль сдвигается вниз на экране.
    
    // В нашем случае "вперед" (нос) на экране всегда смотрит вверх.
    // Значит, смещение камеры "вперед" (в сторону носа) даст корабль ниже на экране.
    // Вектор носа в мире: (Math.cos(camState.angle), Math.sin(camState.angle)).
    
    targetX += Math.cos(camState.angle) * offsetWorld;
    targetY += Math.sin(camState.angle) * offsetWorld;
  }

  return {
    x: targetX,
    y: targetY,
    angle: ship.angle,
  };
}

function onRender(now) {
  beginFrame(now);

  const vp = state.viewport;
  const ctx = canvas.ctx;
  const ship = state.ship;
  const system = state.world.shipSystem;

  const dtReal = Math.min(0.1, (now - lastFrameTime) / 1000);
  lastFrameTime = now;
  
  state._lastDtReal = dtReal;

  tStart('camTarget');
  const target = computeCameraTarget(vp);
  camState.x = target.x;
  camState.y = target.y;
  camState.angle = target.angle;
  camState.zoom *= Math.pow(camera.zoom / camState.zoom, CONFIG.camera.smooth);
  tEnd('camTarget');

  tStart('bg');
  canvas.drawBackground(vp);
  tEnd('bg');

  tStart('stars');
  stars.draw(ctx, vp, camState.x, camState.y);
  tEnd('stars');

  const nearestSys = getNearestSystem(state.world, ship.x, ship.y);

  ctx.save();
  ctx.translate(vp.width / 2, vp.height / 2);
  ctx.scale(camState.zoom, camState.zoom);
  ctx.rotate(-Math.PI / 2 - camState.angle);
  ctx.translate(-camState.x, -camState.y);

  tStart('distantSystems');
  drawDistantSystems(ctx, state.world, camState.x, camState.y, vp, nearestSys);
  tEnd('distantSystems');

  if (system) {
    tStart('currentSystem');
    drawBodies(ctx, system, camState.x, camState.y, vp);
    tEnd('currentSystem');
  }

  tStart('trail');
  drawTrail(ctx, state.trail.points);
  tEnd('trail');

  const { horizon, sampleEvery } = CONFIG.prediction;
  tStart('predCalc');
  const points = predictTrajectory(ship, state.world, horizon, sampleEvery);

  let stopPoint = null;
  let sidePaths = null;
  let stopDist = 0;

  if (!system) {
    stopPoint = predictStopPoint(ship, state.world, dtReal);
    if (stopPoint) {
      const dx = stopPoint.x - ship.x;
      const dy = stopPoint.y - ship.y;
      stopDist = Math.hypot(dx, dy);
    }
    if (stopDist > 0) {
      sidePaths = predictSideTrajectories(ship, state.world, stopDist);
    }
  }
  tEnd('predCalc');

  const activePlanet = dominantBody(system, ship.x, ship.y);
  
  tStart('predDraw');
  drawPrediction(ctx, points, state.tickCount, input.thrust || input.reverse, camState.angle, stopPoint, activePlanet !== null, sidePaths);
  tEnd('predDraw');

  if (activePlanet) {
    tStart('orbitHints');
    drawOrbitHints(ctx, ship, activePlanet, system);
    tEnd('orbitHints');
  }

  tStart('ship');
  drawShip(ctx, ship, input);
  tEnd('ship');

  ctx.restore();

  if (ship.impulse > 0) {
    const dx = ship.x - camState.x;
    const dy = ship.y - camState.y;
    const ca = Math.cos(-Math.PI / 2 - camState.angle);
    const sa = Math.sin(-Math.PI / 2 - camState.angle);
    const rx = dx * ca - dy * sa;
    const ry = dx * sa + dy * ca;
    const screenX = vp.width / 2 + rx * camState.zoom;
    const screenY = vp.height / 2 + ry * camState.zoom;
    
    drawImpulseBar(ctx, ship, screenX, screenY);
  }

  drawThrottleIndicator(ctx, ship, vp);

  endFrame(now);

  tStart('profiler');
  drawProfiler(ctx, vp);
  tEnd('profiler');
}

function onAfterFrame() {
  const system = state.world.shipSystem;
  const planet = dominantBody(system, state.ship.x, state.ship.y);
  const timeScale = planet ? CONFIG.hill.timeScale : 1;
  hud.update(state.ship, state.tickCount, camState.zoom, system, planet, timeScale);
}

function getTimeScale() {
  const system = state.world.shipSystem;
  const planet = dominantBody(system, state.ship.x, state.ship.y);
  let baseScale = planet ? CONFIG.hill.timeScale : 1;
  return baseScale;
}

startLoop({ onTick, onRender, onAfterFrame, getTimeScale });
console.log('[space] v63 config', CONFIG);
</file>

