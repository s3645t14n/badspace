<file path="public/js/render/orbitHints.js">
import { CONFIG } from '../config.js';

export function circularSpeed(planetMass, r) {
  const G = CONFIG.physics.G;
  const soft2 = CONFIG.physics.softening ** 2;
  const r2 = r * r;
  return Math.sqrt((G * planetMass * r2) / Math.pow(r2 + soft2, 1.5));
}

export function drawOrbitHints(ctx, ship, planet, system) {
  const m = ctx.getTransform();
  const zoom = Math.max(Math.hypot(m.a, m.b), 1e-6);

  // === Нормаль к орбите ===
  // Вектор от звезды к кораблю.
  const angleToShip = Math.atan2(ship.y - system.cy, ship.x - system.cx);
  // Точка на орбите планеты.
  const targetX = system.cx + Math.cos(angleToShip) * planet.orbit;
  const targetY = system.cy + Math.sin(angleToShip) * planet.orbit;

  ctx.save();
  ctx.beginPath();
  ctx.moveTo(ship.x, ship.y);
  ctx.lineTo(targetX, targetY);
  ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)'; // Нормаль белая
  ctx.lineWidth = 1.5 / zoom;
  ctx.setLineDash([4 / zoom, 4 / zoom]);
  ctx.stroke();
  ctx.restore();

  // === Остальная логика стрелок (как было) ===
  const rx = ship.x - planet.x;
  const ry = ship.y - planet.y;
  const r = Math.hypot(rx, ry) || 1e-9;
  const ux = rx / r;
  const uy = ry / r;

  const rvx = ship.vx - planet.vx;
  const rvy = ship.vy - planet.vy;

  const vCirc = circularSpeed(planet.mass, r);

  const vTanProj = rvx * (-uy) + rvy * ux;
  const sign = vTanProj >= 0 ? 1 : -1;
  const tvx = -uy * sign;
  const tvy =  ux * sign;

  const cvx = tvx * vCirc;
  const cvy = tvy * vCirc;
  const dvx = cvx - rvx;
  const dvy = cvy - rvy;

  const midX = (ship.x + planet.x) / 2;
  const midY = (ship.y + planet.y) / 2;
  const half = r * 0.6;
  const stepPx = 24;
  const stepWorld = stepPx / zoom;

  ctx.save();
  ctx.strokeStyle = 'rgba(120, 180, 220, 0.18)';
  ctx.lineWidth = 1 / zoom;

  const startX = midX - Math.floor(half / stepWorld) * stepWorld;
  for (let x = startX; x <= midX + half; x += stepWorld) {
    ctx.beginPath();
    ctx.moveTo(x, midY - half);
    ctx.lineTo(x, midY + half);
    ctx.stroke();
  }
  const startY = midY - Math.floor(half / stepWorld) * stepWorld;
  for (let y = startY; y <= midY + half; y += stepWorld) {
    ctx.beginPath();
    ctx.moveTo(midX - half, y);
    ctx.lineTo(midX + half, y);
    ctx.stroke();
  }
  ctx.restore();

  const pixelLen = 60 / zoom;
  const scale = vCirc > 1e-9 ? pixelLen / vCirc : 0;
  const minLenPx = 18 / zoom;

  drawArrow(ctx, ship.x, ship.y, rvx, rvy, scale, minLenPx, 'rgba(255, 90, 90, 0.95)', zoom);
  drawArrow(ctx, ship.x, ship.y, cvx, cvy, scale, minLenPx, 'rgba(90, 255, 130, 0.95)', zoom);
  drawArrow(ctx, ship.x, ship.y, dvx, dvy, scale, minLenPx, 'rgba(255, 220, 80, 0.95)', zoom);
}

function drawArrow(ctx, x0, y0, vx, vy, scale, minLen, color, zoom) {
  let dx = vx * scale;
  let dy = vy * scale;
  let len = Math.hypot(dx, dy);

  const vLen = Math.hypot(vx, vy);
  if (vLen < 1e-9) return;

  if (len < minLen) {
    const ux = dx / len;
    const uy = dy / len;
    dx = ux * minLen;
    dy = uy * minLen;
    len = minLen;
  }

  const ux = dx / len;
  const uy = dy / len;
  const x1 = x0 + dx;
  const y1 = y0 + dy;

  ctx.save();
  ctx.strokeStyle = color;
  ctx.fillStyle = color;
  ctx.lineWidth = 2.5 / zoom;
  ctx.lineCap = 'round';

  ctx.setLineDash([6 / zoom, 4 / zoom]);
  ctx.beginPath();
  ctx.moveTo(x0, y0);
  ctx.lineTo(x1, y1);
  ctx.stroke();
  ctx.setLineDash([]);

  const headLen = 10 / zoom;
  const headW = 6 / zoom;
  const bx = x1 - ux * headLen;
  const by = y1 - uy * headLen;
  const px = -uy * headW;
  const py =  ux * headW;

  ctx.beginPath();
  ctx.moveTo(x1, y1);
  ctx.lineTo(bx + px, by + py);
  ctx.lineTo(bx - px, by - py);
  ctx.closePath();
  ctx.fill();

  ctx.restore();
}
</file>

<file path="public/js/render/prediction.js">
import { CONFIG } from '../config.js';

const MONTH_NAMES_SHORT = [
  'янв', 'фев', 'мар', 'апр', 'мая', 'июн',
  'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'
];
const TICKS_PER_MONTH = 100000 / 120;

export function drawPrediction(ctx, points, currentTick, thrusting, camAngle, stopPoint, inHill, sidePaths) {
  if (!points || points.length < 3) return;

  const maxPts = CONFIG.prediction.maxPoints;
  const step = Math.max(1, Math.ceil(points.length / maxPts));
  const pts = [];
  for (let i = 0; i < points.length; i += step) pts.push(points[i]);
  if (pts[pts.length - 1] !== points[points.length - 1]) {
    pts.push(points[points.length - 1]);
  }
  if (pts.length < 3) return;

  const first = pts[0];
  const last = pts[pts.length - 1];

  if (!Number.isFinite(first.x) || !Number.isFinite(first.y) || 
      !Number.isFinite(last.x) || !Number.isFinite(last.y)) {
    return;
  }

  const m = ctx.getTransform();
  const zoom = Math.max(Math.hypot(m.a, m.b), 1e-6);

  ctx.save();
  ctx.lineJoin = 'round';
  ctx.lineCap = 'round';

  // === Отрисовка боковых траекторий (пунктиром) ===
  if (sidePaths) {
    for (const path of sidePaths) {
      if (!path || path.length < 2) continue;
      ctx.beginPath();
      ctx.moveTo(path[0].x, path[0].y);
      for (let i = 1; i < path.length; i++) {
        ctx.lineTo(path[i].x, path[i].y);
      }
      ctx.strokeStyle = 'rgba(255, 150, 150, 0.4)';
      ctx.lineWidth = 1.5 / zoom;
      ctx.setLineDash([4 / zoom, 4 / zoom]);
      ctx.stroke();
      ctx.setLineDash([]);
    }
  }

  // === Основная линия предикции ===
  const grad = ctx.createLinearGradient(first.x, first.y, last.x, last.y);
  const a = thrusting ? 0.95 : 0.8;
  grad.addColorStop(0, `rgba(255, 70, 70, ${a})`);
  grad.addColorStop(1, `rgba(255, 70, 70, 0)`);

  ctx.strokeStyle = grad;
  ctx.lineWidth = 3.5 / zoom;
  ctx.beginPath();
  ctx.moveTo(first.x, first.y);

  for (let i = 1; i < pts.length - 1; i++) {
    const mx = (pts[i].x + pts[i + 1].x) * 0.5;
    const my = (pts[i].y + pts[i + 1].y) * 0.5;
    ctx.quadraticCurveTo(pts[i].x, pts[i].y, mx, my);
  }
  ctx.lineTo(last.x, last.y);
  ctx.stroke();

  // Засечки месяцев (только не в сфере Хилла)
  if (!inHill) {
    const ticksAhead = CONFIG.prediction.horizon;
    const firstNextMonthTick = Math.ceil((currentTick + 1) / TICKS_PER_MONTH) * TICKS_PER_MONTH;
    const startMonthIndex = 3;
    const startYear = 5027;

    ctx.font = `${12 / zoom}px "Segoe UI", system-ui, sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

    for (let tick = firstNextMonthTick; tick <= currentTick + ticksAhead; tick += TICKS_PER_MONTH) {
      const progress = (tick - currentTick) / ticksAhead;
      const ptIndex = progress * (pts.length - 1);
      const i0 = Math.floor(ptIndex);
      const i1 = Math.min(i0 + 1, pts.length - 1);
      if (i0 < 0 || i0 >= pts.length - 1) continue;
      
      const k = ptIndex - i0;
      const px = pts[i0].x + (pts[i1].x - pts[i0].x) * k;
      const py = pts[i0].y + (pts[i1].y - pts[i0].y) * k;
      
      const dx = pts[i1].x - pts[i0].x;
      const dy = pts[i1].y - pts[i0].y;
      const len = Math.hypot(dx, dy) || 1;
      const nx = -dy / len;
      const ny = dx / len;
      
      const tickSize = 6 / zoom;
      
      ctx.beginPath();
      ctx.moveTo(px - nx * tickSize, py - ny * tickSize);
      ctx.lineTo(px + nx * tickSize, py + ny * tickSize);
      ctx.strokeStyle = `rgba(255, 100, 100, ${a * (1 - progress)})`;
      ctx.lineWidth = 2 / zoom;
      ctx.stroke();

      const monthsTotal = Math.floor(tick / TICKS_PER_MONTH);
      const mIndex = (startMonthIndex + monthsTotal) % 12;
      const year = startYear + Math.floor((startMonthIndex + monthsTotal) / 12);
      
      const monthStr = MONTH_NAMES_SHORT[mIndex];
      const yearStr = String(year).slice(-2);
      const label = `${monthStr} ${yearStr}`;
      
      ctx.save();
      ctx.translate(px + (12 / zoom), py);
      ctx.rotate(Math.PI / 2 + camAngle);
      ctx.fillStyle = `rgba(255, 180, 180, ${a * (1 - progress) * 0.8})`;
      ctx.fillText(label, 0, 0);
      ctx.restore();
    }
  }

  // Окружность остановки (STOP)
  if (stopPoint) {
    const dx = stopPoint.x - first.x;
    const dy = stopPoint.y - first.y;
    const radius = Math.hypot(dx, dy);

    if (radius > 0.1 && Number.isFinite(radius)) {
      ctx.beginPath();
      ctx.arc(first.x, first.y, radius, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255, 80, 80, 0.4)';
      ctx.lineWidth = 1.5 / zoom;
      ctx.stroke();

      ctx.fillStyle = 'rgba(255, 80, 80, 0.7)';
      ctx.font = `bold ${10 / zoom}px "Segoe UI", system-ui, sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      const numLabels = 12;
      for (let i = 0; i < numLabels; i++) {
        const angle = (i / numLabels) * Math.PI * 2;
        const tx = first.x + Math.cos(angle) * radius;
        const ty = first.y + Math.sin(angle) * radius;
        
        ctx.save();
        ctx.translate(tx, ty);
        ctx.rotate(Math.PI / 2 + camAngle); 
        ctx.fillText('STOP', 0, 0);
        ctx.restore();
      }

      ctx.beginPath();
      ctx.arc(stopPoint.x, stopPoint.y, 5 / zoom, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 80, 80, 0.9)';
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 2 / zoom;
      ctx.stroke();
    }
  }

  ctx.restore();
}
</file>

<file path="public/js/render/ship.js">
import { CONFIG } from '../config.js';

export function drawShip(ctx, ship, input) {
  const m = ctx.getTransform();
  const zoom = Math.max(Math.hypot(m.a, m.b), 1e-6);

  const worldPx = ship.radius * zoom;
  const s = Math.max(1, CONFIG.ship.minScreenRadius / worldPx);

  ctx.save();
  ctx.translate(ship.x, ship.y);
  ctx.rotate(ship.angle);
  ctx.scale(s, s);

  const r = ship.radius;
  const tMain = ship.throttleMain;
  const tLat  = ship.throttleLateral;

  // Задний двигатель / реверс (пропорционально throttle).
  if (Math.abs(tMain) > 0.03) {
    const flameLen = (14 + Math.random() * 6) * Math.abs(tMain);
    const grad = ctx.createLinearGradient(-r, 0, -r - flameLen, 0);
    if (tMain > 0) {
      grad.addColorStop(0,   'rgba(120, 220, 255, 0.95)');
      grad.addColorStop(0.5, 'rgba(80, 160, 255, 0.6)');
      grad.addColorStop(1,   'rgba(80, 160, 255, 0)');
    } else {
      grad.addColorStop(0,   'rgba(255, 180, 120, 0.95)');
      grad.addColorStop(0.5, 'rgba(255, 120, 80, 0.6)');
      grad.addColorStop(1,   'rgba(255, 120, 80, 0)');
    }
    const w = 4 * Math.abs(tMain) + 1;
    ctx.beginPath();
    ctx.moveTo(-r + 2, -w);
    ctx.lineTo(-r - flameLen, 0);
    ctx.lineTo(-r + 2, w);
    ctx.closePath();
    ctx.fillStyle = grad;
    ctx.fill();
  }

  // Боковые сопла (пропорционально throttle).
  if (Math.abs(tLat) > 0.03) {
    const flameLen = (10 + Math.random() * 6) * Math.abs(tLat);
    const side = tLat > 0 ? -1 : 1;
    const grad = ctx.createLinearGradient(0, side * r, 0, side * (r + flameLen));
    grad.addColorStop(0,   'rgba(255, 220, 120, 0.95)');
    grad.addColorStop(0.5, 'rgba(255, 180, 80, 0.6)');
    grad.addColorStop(1,   'rgba(255, 180, 80, 0)');

    const w = 3 * Math.abs(tLat) + 1;
    ctx.beginPath();
    ctx.moveTo(-w, side * (r - 1));
    ctx.lineTo(0,  side * (r + flameLen));
    ctx.lineTo(w,  side * (r - 1));
    ctx.closePath();
    ctx.fillStyle = grad;
    ctx.fill();
  }

  // Корпус.
  ctx.beginPath();
  ctx.moveTo(r, 0);
  ctx.lineTo(-r * 0.75, -r * 0.7);
  ctx.lineTo(-r * 0.4, 0);
  ctx.lineTo(-r * 0.75, r * 0.7);
  ctx.closePath();

  const bodyGrad = ctx.createLinearGradient(-r, 0, r, 0);
  bodyGrad.addColorStop(0, '#1e3a5f');
  bodyGrad.addColorStop(1, '#9fd9ff');
  ctx.fillStyle = bodyGrad;
  ctx.strokeStyle = '#cfefff';
  ctx.lineWidth = 1.5;
  ctx.fill();
  ctx.stroke();

  // Кабина.
  ctx.beginPath();
  ctx.arc(r * 0.15, 0, r * 0.25, 0, Math.PI * 2);
  ctx.fillStyle = '#7fffd4';
  ctx.shadowColor = '#7fffd4';
  ctx.shadowBlur = 10;
  ctx.fill();
  ctx.shadowBlur = 0;

  ctx.restore();
}
</file>

<file path="public/js/render/stars.js">
import { CONFIG } from '../config.js';

// Фоновые звёзды с параллаксом. Рисуются в ЧИСТО экранных координатах
// (без учёта camera.zoom) — иначе при сильном отдалении звёздный слой
// сжимался бы в маленькое окошко вокруг центра.
export function createStarField() {
  const layers = CONFIG.stars.layers.map((cfg) => ({
    ...cfg,
    stars: [],
    worldW: 0,
    worldH: 0,
  }));

  function init(width, height) {
    const mult = CONFIG.stars.worldMultiplier;
    const worldW = width * mult;
    const worldH = height * mult;

    for (const layer of layers) {
      layer.worldW = worldW;
      layer.worldH = worldH;
      layer.stars.length = 0;
      for (let i = 0; i < layer.count; i++) {
        layer.stars.push({
          x: Math.random() * worldW,
          y: Math.random() * worldH,
          size: layer.size[0] + Math.random() * (layer.size[1] - layer.size[0]),
          twinkle: Math.random() * Math.PI * 2,
          twinkleSpeed: 0.005 + Math.random() * 0.02,
          hue: 200 + Math.random() * 60,
        });
      }
    }
  }

  function draw(ctx, { width, height }, camX, camY) {
    for (const layer of layers) {
      const offX = -camX * layer.depth;
      const offY = -camY * layer.depth;

      for (const s of layer.stars) {
        let sx = (s.x + offX) % layer.worldW;
        let sy = (s.y + offY) % layer.worldH;
        if (sx < 0) sx += layer.worldW;
        if (sy < 0) sy += layer.worldH;

        s.twinkle += s.twinkleSpeed;
        const a = layer.alpha * (0.65 + 0.35 * Math.sin(s.twinkle));

        for (let tx = -1; tx <= 1; tx++) {
          for (let ty = -1; ty <= 1; ty++) {
            const px = sx + tx * layer.worldW;
            const py = sy + ty * layer.worldH;
            if (px < -20 || px > width + 20 || py < -20 || py > height + 20) continue;

            ctx.beginPath();
            ctx.fillStyle = `hsla(${s.hue}, 60%, 88%, ${a})`;
            if (layer.glow) {
              ctx.shadowColor = `hsla(${s.hue}, 80%, 80%, ${a})`;
              ctx.shadowBlur = 8;
            }
            ctx.arc(px, py, s.size, 0, Math.PI * 2);
            ctx.fill();
            ctx.shadowBlur = 0;
          }
        }
      }
    }
  }

  return { init, draw };
}
</file>

<file path="public/js/render/throttleIndicator.js">
export function drawThrottleIndicator(ctx, ship, vp) {
  const x = 60;
  const y = vp.height - 60;
  const size = 40; // Половина размера крестовины

  ctx.save();

  // Фон
  ctx.fillStyle = 'rgba(0, 0, 0, 0.4)';
  ctx.fillRect(x - size - 10, y - size - 10, size * 2 + 20, size * 2 + 20);

  // Оси
  ctx.strokeStyle = 'rgba(120, 200, 255, 0.3)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(x - size, y); ctx.lineTo(x + size, y);
  ctx.moveTo(x, y - size); ctx.lineTo(x, y + size);
  ctx.stroke();

  // Текущая точка (throttleLateral по X, throttleMain по Y)
  const px = x + ship.throttleLateral * size;
  const py = y - ship.throttleMain * size;

  // Линии от центра до точки
  ctx.strokeStyle = 'rgba(127, 255, 212, 0.5)';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.moveTo(x, y); ctx.lineTo(px, py);
  ctx.stroke();

  // Точка
  ctx.beginPath();
  ctx.arc(px, py, 4, 0, Math.PI * 2);
  ctx.fillStyle = '#7fffd4';
  ctx.shadowColor = '#7fffd4';
  ctx.shadowBlur = 10;
  ctx.fill();

  ctx.restore();
}
