import { CONFIG } from '../config.js';
import { gravityAt } from './gravity.js';
import { allBodies, dominantBody } from '../entities/bodies.js';
import { updateImpulse } from './impulse.js';

export function simulateTick(state, input, bodies, dtRealSeconds) {
  state.tickCount++;
  const ship = state.ship;
  const world = state.world;
  const system = world.shipSystem;
  const capture = world.captureSystem;
  const bodiesList = allBodies(system);
  const dt = 1;

  const { turnAccel, turnMax, turnDamping, throttleRate } = CONFIG.physics;
  const { accel, lateralAccel } = CONFIG.physics;

  if (!Number.isFinite(dtRealSeconds) || dtRealSeconds <= 0) dtRealSeconds = 0.016;
  if (!Number.isFinite(ship.throttleMain)) ship.throttleMain = 0;
  if (!Number.isFinite(ship.throttleLateral)) ship.throttleLateral = 0;
  if (!Number.isFinite(ship.angle)) ship.angle = 0;
  if (!Number.isFinite(ship.angularVel)) ship.angularVel = 0;

  const rate = throttleRate * dtRealSeconds;
  
  if (input.thrust) ship.throttleMain = Math.min(1, ship.throttleMain + rate);
  else if (input.reverse) ship.throttleMain = Math.max(-1, ship.throttleMain - rate);
  else {
    if (Math.abs(ship.throttleMain) <= rate) ship.throttleMain = 0;
    else ship.throttleMain -= Math.sign(ship.throttleMain) * rate;
  }

  if (input.turnRight) ship.throttleLateral = Math.min(1, ship.throttleLateral + rate);
  else if (input.turnLeft) ship.throttleLateral = Math.max(-1, ship.throttleLateral - rate);
  else {
    if (Math.abs(ship.throttleLateral) <= rate) ship.throttleLateral = 0;
    else ship.throttleLateral -= Math.sign(ship.throttleLateral) * rate;
  }

  updateImpulse(state, input, system, dtRealSeconds);

  const planet = dominantBody(system, ship.x, ship.y);
  let targetAngle = ship.angle;
  if (planet) {
    const dx = ship.x - system.cx;
    const dy = ship.y - system.cy;
    if (dx !== 0 || dy !== 0) {
      const angleToShip = Math.atan2(dy, dx);
      const direction = planet.omega > 0 ? 1 : -1;
      targetAngle = angleToShip + direction * Math.PI / 2;
    }
  } else {
    const speed = Math.hypot(ship.vx, ship.vy);
    if (speed > 0.01) {
      targetAngle = Math.atan2(ship.vy, ship.vx);
    }
  }

  const turnSpeed = 0.05;
  const diff = angleDiff(ship.angle, targetAngle);
  ship.angle += diff * turnSpeed;

  while (ship.angle > Math.PI) ship.angle -= Math.PI * 2;
  while (ship.angle < -Math.PI) ship.angle += Math.PI * 2;

  const ca = Math.cos(ship.angle);
  const sa = Math.sin(ship.angle);

  const fwd = accel * ship.throttleMain;
  const lat = lateralAccel * ship.throttleLateral;

  const rx = -sa;
  const ry =  ca;

  const tx = ca * fwd + rx * lat;
  const ty = sa * fwd + ry * lat;

  const g1 = gravityAt(ship.x, ship.y, bodiesList);
  ship.vx += (g1.ax + tx) * 0.5 * dt;
  ship.vy += (g1.ay + ty) * 0.5 * dt;

  if (!system && capture) {
    const dx = capture.cx - ship.x;
    const dy = capture.cy - ship.y;
    const r = Math.hypot(dx, dy) || 1e-9;
    const t = 1 - Math.min(1, (r - capture.influenceRadius) / (capture.captureRadius - capture.influenceRadius));
    const strength = CONFIG.physics.G * capture.star.mass / (r * r) * t * 0.3;
    ship.vx += (dx / r) * strength * 0.5 * dt;
    ship.vy += (dy / r) * strength * 0.5 * dt;
  }

  ship.x += ship.vx * dt;
  ship.y += ship.vy * dt;

  const g2 = gravityAt(ship.x, ship.y, bodiesList);
  ship.vx += (g2.ax + tx) * 0.5 * dt;
  ship.vy += (g2.ay + ty) * 0.5 * dt;

  if (!system && capture) {
    const dx = capture.cx - ship.x;
    const dy = capture.cy - ship.y;
    const r = Math.hypot(dx, dy) || 1e-9;
    const t = 1 - Math.min(1, (r - capture.influenceRadius) / (capture.captureRadius - capture.influenceRadius));
    const strength = CONFIG.physics.G * capture.star.mass / (r * r) * t * 0.3;
    ship.vx += (dx / r) * strength * 0.5 * dt;
    ship.vy += (dy / r) * strength * 0.5 * dt;
  }

  if (!Number.isFinite(ship.x) || !Number.isFinite(ship.y) || !Number.isFinite(ship.vx) || !Number.isFinite(ship.vy)) {
    console.error('[physics] Force reset due to NaN!', { ship });
    if (system) {
      ship.x = system.cx + CONFIG.ship.startOrbit;
      ship.y = system.cy;
    } else {
      ship.x = 0;
      ship.y = 0;
    }
    ship.vx = 0;
    ship.vy = 0;
    ship.angle = 0;
    ship.angularVel = 0;
  }
}

function angleDiff(a, b) {
  let d = b - a;
  while (d >  Math.PI) d -= Math.PI * 2;
  while (d < -Math.PI) d += Math.PI * 2;
  return d;
}

export function predictTrajectory(ship, world, horizonTicks, sampleEvery) {
  const dt = 1;
  const system = world.shipSystem;
  const capture = world.captureSystem;
  
  let body = null;
  let bodyVx = 0, bodyVy = 0;

  if (system) {
    const planet = dominantBody(system, ship.x, ship.y);
    if (planet) {
      body = { x: planet.x, y: planet.y, mass: planet.mass };
      bodyVx = planet.vx;
      bodyVy = planet.vy;
    } else {
      body = { x: system.star.x, y: system.star.y, mass: system.star.mass };
      bodyVx = system.starVx;
      bodyVy = system.starVy;
    }
  } else if (capture) {
    const gcX = CONFIG.galaxy.centerX;
    const gcY = CONFIG.galaxy.centerY;
    const galAngle = capture.galPhase + capture.galOmega * world.globalTime;
    const cx = gcX + Math.cos(galAngle) * capture.galR;
    const cy = gcY + Math.sin(galAngle) * capture.galR;
    
    body = { x: cx, y: cy, mass: capture.star.mass };
    bodyVx = -Math.sin(galAngle) * capture.galOmega * capture.galR;
    bodyVy =  Math.cos(galAngle) * capture.galOmega * capture.galR;
  }

  if (!body) {
    let { x, y, vx, vy } = ship;
    const points = [{ x, y }];
    for (let i = 0; i < horizonTicks; i++) {
      x += vx * dt;
      y += vy * dt;
      if (i % sampleEvery === 0) points.push({ x, y });
    }
    return points;
  }

  let x = ship.x - body.x;
  let y = ship.y - body.y;
  let vx = ship.vx - bodyVx;
  let vy = ship.vy - bodyVy;
  
  const points = [{ x: ship.x, y: ship.y }];

  for (let i = 0; i < horizonTicks; i++) {
    const g1 = gravityAt(x, y, [{ x: 0, y: 0, mass: body.mass }]);
    vx += g1.ax * 0.5 * dt;
    vy += g1.ay * 0.5 * dt;
    x += vx * dt;
    y += vy * dt;

    const g2 = gravityAt(x, y, [{ x: 0, y: 0, mass: body.mass }]);
    vx += g2.ax * 0.5 * dt;
    vy += g2.ay * 0.5 * dt;

    if (i % sampleEvery === 0) {
      points.push({ x: x + body.x, y: y + body.y });
    }
  }

  return points;
}

// Упрощенная версия: без гравитации, только кинематика и боковой газ.
export function predictSideTrajectories(ship, world, stopDistance) {
  const dt = 1;
  const system = world.shipSystem;
  
  if (system) return null;

  const ca = Math.cos(ship.angle);
  const sa = Math.sin(ship.angle);
  const rx = -sa, ry = ca;
  
  const maxTicks = Math.ceil(stopDistance / Math.max(0.1, Math.hypot(ship.vx, ship.vy))) + 100;

  const makePath = (latDir) => {
    let x = ship.x, y = ship.y, vx = ship.vx, vy = ship.vy;
    const lat = CONFIG.physics.lateralAccel * latDir;
    const tx = rx * lat, ty = ry * lat;
    
    const pts = [];
    for (let i = 0; i < maxTicks; i++) {
      vx += tx * dt;
      vy += ty * dt;
      x += vx * dt;
      y += vy * dt;
      
      if (i % 20 === 0) pts.push({ x, y });
      
      if (Math.hypot(x - ship.x, y - ship.y) >= stopDistance) {
        pts.push({ x, y });
        break;
      }
    }
    return pts;
  };

  return [ makePath(1), makePath(-1) ];
}

export function predictStopPoint(ship, world, dtRealSeconds) {
  const dt = 1;
  const system = world.shipSystem;
  if (system) return null;

  const capture = world.captureSystem;
  const bodiesList = allBodies(system);

  let { x, y, vx, vy } = ship;
  let stopX = null, stopY = null;

  for (let i = 0; i < 30000; i++) {
    const ca = Math.cos(ship.angle);
    const sa = Math.sin(ship.angle);
    
    const fwd = -CONFIG.physics.accel;
    const tx = ca * fwd;
    const ty = sa * fwd;

    const g1 = gravityAt(x, y, bodiesList);
    vx += (g1.ax + tx) * 0.5 * dt;
    vy += (g1.ay + ty) * 0.5 * dt;
    
    if (!system && capture) {
      const dx = capture.cx - x;
      const dy = capture.cy - y;
      const r = Math.hypot(dx, dy) || 1e-9;
      const t = 1 - Math.min(1, (r - capture.influenceRadius) / (capture.captureRadius - capture.influenceRadius));
      const strength = CONFIG.physics.G * capture.star.mass / (r * r) * t * 0.3;
      vx += (dx / r) * strength * 0.5 * dt;
      vy += (dy / r) * strength * 0.5 * dt;
    }

    x += vx * dt;
    y += vy * dt;

    const g2 = gravityAt(x, y, bodiesList);
    vx += (g2.ax + tx) * 0.5 * dt;
    vy += (g2.ay + ty) * 0.5 * dt;

    if (!system && capture) {
      const dx = capture.cx - x;
      const dy = capture.cy - y;
      const r = Math.hypot(dx, dy) || 1e-9;
      const t = 1 - Math.min(1, (r - capture.influenceRadius) / (capture.captureRadius - capture.influenceRadius));
      const strength = CONFIG.physics.G * capture.star.mass / (r * r) * t * 0.3;
      vx += (dx / r) * strength * 0.5 * dt;
      vy += (dy / r) * strength * 0.5 * dt;
    }

    const speed = Math.hypot(vx, vy);
    if (speed < 0.05) {
      stopX = x;
      stopY = y;
      break;
    }
  }

  return stopX !== null ? { x: stopX, y: stopY } : null;
}
